# Konfiguration für startup.sh

# Seite, die geöffnet wird
URL="https://scorer.darthelfer.de/"

# Touchscreen (Name wie in `xinput list`) und der Monitor, an dem er hängt (Name wie in `xrandr`)
TOUCH_NAME="wch.cn TouchScreen"
TOUCH_OUTPUT="HDMI-2"

# 1 = Touch-Koordinaten um 180° drehen (wie im alten Script), 0 = nur dem Monitor zuordnen
TOUCH_ROTATE_180=1

# Monitor für das zweite Fenster. Leer = erster angeschlossener Monitor, der nicht TOUCH_OUTPUT ist
TARGET_OUTPUT=""

# Welcher Knopf soll geklickt werden? Eins von beiden setzen:
#   BUTTON_TEXT     = Beschriftung des Knopfs (Groß-/Kleinschreibung egal, reguläre Ausdrücke erlaubt)
#   BUTTON_SELECTOR = CSS-Selektor (hat Vorrang vor BUTTON_TEXT)
# Beide leer: das Script listet alle klickbaren Elemente der Seite auf, damit du den Knopf findest.
BUTTON_TEXT=""
BUTTON_SELECTOR=""

# Maximale Wartezeit in Sekunden (Seite lädt / Knopf erscheint / neues Fenster öffnet sich)
TIMEOUT=60

# Eigenes Firefox-Profil, damit Einstellungen der Seite (z. B. localStorage) erhalten bleiben
FIREFOX_PROFILE="$HOME/.config/scorer-launcher/firefox-profile"
